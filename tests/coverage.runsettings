<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings (pass with the dotnet test "settings" option, see README "Tests and CI").
     Measures the app's own assemblies only and leaves out generated EF migrations. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Kopeck.*]*</Include>
          <Exclude>[Kopeck.*.Tests]*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

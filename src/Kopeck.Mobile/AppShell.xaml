<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Navigation:
    //login                 sign-in (register, verify and reset are pushed on top)
    //budgets               pick a budget
    //main/{tab}            the open budget, with a bottom tab bar:
                            overview · expenses · income · plan · more (categories and share are pushed from "more")
-->
<Shell x:Class="Kopeck.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Kopeck.Mobile.Views"
       FlyoutBehavior="Disabled">
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="budgets" ContentTemplate="{DataTemplate views:BudgetsPage}" />

    <TabBar Route="main">
        <Tab Title="Overview" Icon="tab_overview.png" Route="overview">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Expenses" Icon="tab_expenses.png" Route="expenses">
            <ShellContent ContentTemplate="{DataTemplate views:ExpensesPage}" />
        </Tab>
        <Tab Title="Income" Icon="tab_income.png" Route="income">
            <ShellContent ContentTemplate="{DataTemplate views:IncomePage}" />
        </Tab>
        <Tab Title="Plan" Icon="tab_plan.png" Route="plan">
            <ShellContent ContentTemplate="{DataTemplate views:PlanPage}" />
        </Tab>
        <Tab Title="More" Icon="tab_more.png" Route="more">
            <ShellContent ContentTemplate="{DataTemplate views:MorePage}" />
        </Tab>
    </TabBar>
</Shell>

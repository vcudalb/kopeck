<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.YearPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             xmlns:charts="clr-namespace:Kopeck.Mobile.Views.Charts"
             x:DataType="vm:YearViewModel"
             Title="Year">
    <ContentPage.Resources>
        <Style x:Key="StatLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <!-- ‹ 2026 › -->
                <Border Style="{StaticResource Card}" Padding="4">
                    <Grid ColumnDefinitions="44,*,44" HeightRequest="44">
                        <Grid SemanticProperties.Description="Previous year">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding PreviousYearCommand}" /></Grid.GestureRecognizers>
                            <Image Source="chevron_left.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Grid.Column="1" Text="{Binding YearText}" Style="{StaticResource Strong}" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Grid Grid.Column="2" SemanticProperties.Description="Next year">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding NextYearCommand}" /></Grid.GestureRecognizers>
                            <Image Source="chevron_right.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                </Border>

                <!-- Year totals -->
                <Border Style="{StaticResource HeroCard}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Left this year (income − spent − saved)" Style="{StaticResource StatLabel}" FontSize="13" />
                            <Label Text="{Binding LeftText}" TextColor="{StaticResource OnPrimary}" FontSize="28" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <VerticalStackLayout>
                                <Label Text="Income" Style="{StaticResource StatLabel}" />
                                <Label Text="{Binding IncomeText}" Style="{StaticResource StatValue}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Spent" Style="{StaticResource StatLabel}" />
                                <Label Text="{Binding SpentText}" Style="{StaticResource StatValue}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="Saved" Style="{StaticResource StatLabel}" />
                                <Label Text="{Binding SavedText}" Style="{StaticResource StatValue}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Per month -->
                <Label Text="PER MONTH" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Field}">
                    <Picker Title="Show" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ChartTitle}" Style="{StaticResource Strong}" />
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Legend}" Spacing="16">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LegendItem">
                                    <HorizontalStackLayout Spacing="6">
                                        <RoundRectangle Fill="{Binding Color}" CornerRadius="3" WidthRequest="12" HeightRequest="12"
                                                        VerticalOptions="Center" IsVisible="{Binding IsBar}" />
                                        <RoundRectangle Fill="{Binding Color}" CornerRadius="1" WidthRequest="14" HeightRequest="2"
                                                        VerticalOptions="Center" IsVisible="{Binding IsMarker}" />
                                        <Label Text="{Binding Name}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <charts:ChartView Chart="{Binding MonthlyChart}" TapCommand="{Binding SelectMonthCommand}" HeightRequest="200"
                                          SemanticProperties.Description="Bars per month; tap a month to read its numbers below" />
                        <Label Text="{Binding SelectedMonthText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- By category -->
                <Label Text="SPENT BY CATEGORY" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout>
                        <Label Text="No spending this year." Style="{StaticResource Muted}" Padding="0,10"
                               IsVisible="{Binding HasCategories, Converter={StaticResource InvertBool}}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryYearRow">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,44" ColumnSpacing="10" RowSpacing="6" Padding="0,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:YearViewModel}}, Path=ShowCategoryCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <RoundRectangle Fill="{Binding Color}" CornerRadius="3" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Caption}" HorizontalOptions="End" VerticalOptions="Center" />
                                        <charts:ChartView Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Chart="{Binding Bar}" HeightRequest="6" InputTransparent="True" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Tap a category to see it month by month above." Style="{StaticResource Caption}" IsVisible="{Binding HasCategories}" />
                <Label Text="{Binding CurrencyNote}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:BasePage>

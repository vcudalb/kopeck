<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.ResetPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:ResetViewModel"
             Title="Reset password">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480">
            <VerticalStackLayout Spacing="4">
                <Label Text="Reset your password" Style="{StaticResource Headline}" />
                <Label Text="We'll email you a code, then you can choose a new password." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="16,20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="1. Your email" Style="{StaticResource Title}" FontSize="16" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="you@example.com" Keyboard="Email" Text="{Binding Email}" />
                    </Border>
                    <Button Text="Email me a code" Command="{Binding SendCodeCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource SecondaryButton}" />
                    <Label Text="{Binding Info}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="2. Choose a new password" Style="{StaticResource Title}" FontSize="16" />
                    <Label Text="Code from the email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="000000" Keyboard="Numeric" MaxLength="6" Text="{Binding Code}" />
                    </Border>
                    <Label Text="New password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="At least 8 characters" IsPassword="True" Text="{Binding NewPassword}" />
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                    </Border>
                    <Button Text="Change password" Command="{Binding ResetCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>

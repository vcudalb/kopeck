<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.LoginPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Sign in">
    <ScrollView>
        <VerticalStackLayout Padding="24,56,24,24" Spacing="16" MaximumWidthRequest="480">
            <Image Source="logo.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Start" />
            <VerticalStackLayout Spacing="4">
                <Label Text="Welcome to Kopeck" Style="{StaticResource Headline}" />
                <Label Text="Plan your month, track every expense and see what's left." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="16,20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="you@example.com" Keyboard="Email" Text="{Binding Email}" ReturnType="Next" />
                    </Border>
                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="Your password" IsPassword="True" Text="{Binding Password}"
                               ReturnType="Go" ReturnCommand="{Binding SignInCommand}" />
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                    </Border>
                    <Button Text="Sign in" Command="{Binding SignInCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,4,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                    <Button Text="Forgot password?" Command="{Binding ForgotPasswordCommand}" Style="{StaticResource TextButton}" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="New to Kopeck?" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Button Text="Create an account" Command="{Binding RegisterCommand}" Style="{StaticResource TextButton}"
                        FontAttributes="Bold" Padding="4,0" />
            </HorizontalStackLayout>

            <!-- Developer setting, folded away -->
            <VerticalStackLayout Spacing="8" Margin="0,16,0,0">
                <Button Text="Server settings" Command="{Binding ToggleServerCommand}" Style="{StaticResource TextButton}"
                        FontSize="13" HorizontalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                <Border Style="{StaticResource Field}" IsVisible="{Binding ShowServer}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="ic_server.png" WidthRequest="20" HeightRequest="20" />
                        <Entry Grid.Column="1" Text="{Binding ServerUrl}" Keyboard="Url" FontSize="14" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>

<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.VerifyPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:VerifyViewModel"
             Title="Verify email">
    <ScrollView><VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="{Binding Email, StringFormat='Enter the 6-digit code sent to {0}'}" />
        <Entry Placeholder="123456" Keyboard="Numeric" MaxLength="6" Text="{Binding Code}" />
        <Label Text="{Binding Info}" TextColor="Gray" />
        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Button Text="Verify" Command="{Binding VerifyCommand}" IsEnabled="{Binding IsNotBusy}" />
        <Button Text="Resend code" Command="{Binding ResendCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Primary}" />
    </VerticalStackLayout></ScrollView>
</views:BasePage>

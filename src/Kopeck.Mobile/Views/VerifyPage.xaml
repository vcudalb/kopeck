<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.VerifyPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:VerifyViewModel"
             Title="Verify email">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480">
            <VerticalStackLayout Spacing="4">
                <Label Text="Check your email" Style="{StaticResource Headline}" />
                <Label Text="{Binding Email, StringFormat='Enter the 6-digit code we sent to {0}.'}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" Padding="16,20">
                <VerticalStackLayout Spacing="12">
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="000000" Keyboard="Numeric" MaxLength="6" Text="{Binding Code}"
                               FontSize="26" CharacterSpacing="8" HorizontalTextAlignment="Center"
                               ReturnType="Go" ReturnCommand="{Binding VerifyCommand}" />
                    </Border>
                    <Label Text="{Binding Info}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                    </Border>
                    <Button Text="Verify and continue" Command="{Binding VerifyCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                    <Button Text="Didn't get it? Send a new code" Command="{Binding ResendCommand}" Style="{StaticResource TextButton}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>

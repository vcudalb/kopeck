<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Kopeck.Mobile.Views.PlanPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:PlanViewModel"
             Title="Planned expenses">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="8">
        <VerticalStackLayout>
            <Label Text="{Binding MonthText}" FontSize="18" FontAttributes="Bold" />
            <Label Text="Set how much you plan to spend per category this month." FontSize="12" TextColor="Gray" />
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.EmptyView><Label Text="Create categories first." TextColor="Gray" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:PlanRow">
                <Grid ColumnDefinitions="*,140" Padding="0,2">
                    <Label Text="{Binding Name}" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Keyboard="Numeric" Placeholder="0" HorizontalTextAlignment="End" Text="{Binding AmountText}" />
                </Grid>
            </DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="6" IsVisible="{Binding CanEdit}">
            <Button Text="Save plan" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Button Text="Copy missing amounts from previous month" Command="{Binding CopyPreviousMonthCommand}" BackgroundColor="Gray" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.PlanPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             xmlns:controls="clr-namespace:Kopeck.Mobile.Views.Controls"
             x:DataType="vm:PlanViewModel"
             Title="Plan">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="16,16,16,0" Spacing="12">
            <controls:MonthSwitcher />
            <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                <Label Text="Planned this month" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource Title}" />
            </Grid>
            <Label Text="How much do you plan to spend per category?" Style="{StaticResource Caption}" Padding="4,0" IsVisible="{Binding CanEdit}" />
            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None" Margin="16,8,16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="16,40" Spacing="6">
                    <Label Text="No categories yet" Style="{StaticResource Title}" HorizontalOptions="Center" />
                    <Label Text="Add categories under More → Categories first." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanRow">
                    <Border Style="{StaticResource Row}" Padding="14,6">
                        <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                            <Label Text="{Binding Name}" Style="{StaticResource Strong}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Border Grid.Column="1" Style="{StaticResource Field}" MinimumHeightRequest="44">
                                <Entry Keyboard="Numeric" Placeholder="0.00" HorizontalTextAlignment="End" Text="{Binding AmountText}"
                                       IsReadOnly="{Binding Source={RelativeSource AncestorType={x:Type vm:PlanViewModel}}, Path=IsReadOnly}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Action bar -->
        <Border Grid.Row="2" IsVisible="{Binding CanEdit}" StrokeThickness="0" Padding="16,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Copy last month" Command="{Binding CopyPreviousMonthCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsNotBusy}" />
                <Button Grid.Column="1" Text="Save plan" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Border>
    </Grid>
</views:BasePage>

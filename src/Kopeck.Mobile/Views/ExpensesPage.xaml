<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.ExpensesPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Kopeck.Contracts;assembly=Kopeck.Contracts"
             xmlns:controls="clr-namespace:Kopeck.Mobile.Views.Controls"
             x:DataType="vm:ExpensesViewModel"
             Title="Expenses">
    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="16,16,16,0" RowSpacing="12">
            <VerticalStackLayout Spacing="12">
                <controls:MonthSwitcher />
                <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                    <Label Text="Spent this month" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource Title}" />
                </Grid>
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                </Border>
            </VerticalStackLayout>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="16,40" Spacing="6">
                            <Label Text="No expenses this month" Style="{StaticResource Title}" HorizontalOptions="Center" />
                            <Label Text="Tap + to add one." Style="{StaticResource Muted}" HorizontalOptions="Center" IsVisible="{Binding CanEdit}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="96" Color="Transparent" />
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ExpenseDto">
                            <SwipeView BackgroundColor="Transparent" Margin="0,4">
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}}, Path=CanEdit}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}}, Path=DeleteCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Style="{StaticResource Row}" Margin="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesViewModel}}, Path=EditCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding CategoryName}" Style="{StaticResource Strong}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Note}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Amount, StringFormat='{0:N2}'}" Style="{StaticResource Strong}" HorizontalOptions="End" />
                                            <Label Text="{Binding Date, StringFormat='{0:d MMM}'}" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <Border Style="{StaticResource Fab}" IsVisible="{Binding ShowAddButton}" SemanticProperties.Description="Add expense">
            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenFormCommand}" /></Border.GestureRecognizers>
            <Image Source="plus.png" WidthRequest="24" HeightRequest="24" />
        </Border>

        <!-- Add / edit sheet -->
        <Grid IsVisible="{Binding IsFormOpen}">
            <BoxView Color="{StaticResource Scrim}">
                <BoxView.GestureRecognizers><TapGestureRecognizer Command="{Binding CloseFormCommand}" /></BoxView.GestureRecognizers>
            </BoxView>
            <Border Style="{StaticResource Sheet}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding FormTitle}" Style="{StaticResource Title}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Cancel" Command="{Binding CloseFormCommand}" Style="{StaticResource TextButton}" />
                    </Grid>
                    <Label Text="Category" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Picker Title="Choose a category" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCategory}" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Label Text="Amount" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="Date" Style="{StaticResource FieldLabel}" />
                        <Border Grid.Row="1" Style="{StaticResource Field}">
                            <Entry Placeholder="0.00" Keyboard="Numeric" Text="{Binding Amount}" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}">
                            <DatePicker Date="{Binding Date}" />
                        </Border>
                    </Grid>
                    <Label Text="Note" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="Optional" Text="{Binding Note}" MaxLength="200" />
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                    </Border>
                    <Button Text="{Binding SubmitText}" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</views:BasePage>

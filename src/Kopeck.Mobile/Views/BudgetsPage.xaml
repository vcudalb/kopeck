<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Kopeck.Mobile.Views.BudgetsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Kopeck.Contracts;assembly=Kopeck.Contracts"
             x:DataType="vm:BudgetsViewModel"
             Title="My budgets">
    <ContentPage.ToolbarItems><ToolbarItem Text="Sign out" Command="{Binding SignOutCommand}" /></ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0">
            <Label Text="{Binding Greeting}" FontSize="18" />
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView><Label Text="No budgets yet. Create one below." TextColor="Gray" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate x:DataType="dto:BudgetDto">
                <Border Style="{StaticResource Card}" Margin="0,4">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BudgetsViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Currency}" TextColor="Gray" />
                        <Label Text="{Binding Role, StringFormat='Your access: {0}'}" TextColor="Gray" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2" ColumnDefinitions="*,80,Auto" ColumnSpacing="8">
            <Entry Placeholder="New budget name" Text="{Binding NewName}" />
            <Entry Grid.Column="1" Placeholder="EUR" Text="{Binding NewCurrency}" MaxLength="5" />
            <Button Grid.Column="2" Text="Add" Command="{Binding CreateCommand}" />
        </Grid>
    </Grid>
</ContentPage>

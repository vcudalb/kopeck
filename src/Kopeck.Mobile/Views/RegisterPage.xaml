<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.RegisterPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:RegisterViewModel"
             Title="Create account">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480">
            <VerticalStackLayout Spacing="4">
                <Label Text="Create your account" Style="{StaticResource Headline}" />
                <Label Text="We'll email you a 6-digit code to confirm your address." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" Padding="16,20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Your name" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="How others will see you" Text="{Binding DisplayName}" ReturnType="Next" />
                    </Border>
                    <Label Text="Email" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="you@example.com" Keyboard="Email" Text="{Binding Email}" ReturnType="Next" />
                    </Border>
                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Placeholder="At least 8 characters" IsPassword="True" Text="{Binding Password}"
                               ReturnType="Go" ReturnCommand="{Binding CreateAccountCommand}" />
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                    </Border>
                    <Button Text="Create account" Command="{Binding CreateAccountCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,4,0,0" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>

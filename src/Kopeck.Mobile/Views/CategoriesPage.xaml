<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.CategoriesPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Kopeck.Contracts;assembly=Kopeck.Contracts"
             x:DataType="vm:CategoriesViewModel"
             Title="Categories">
    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="16,16,16,0" RowSpacing="8">
            <VerticalStackLayout Spacing="8">
                <Label Text="Group your expenses, e.g. Home, Bills, Fuel. Tap one to rename it, swipe left to delete."
                       Style="{StaticResource Caption}" Padding="4,0" IsVisible="{Binding CanEdit}" />
                <Label Text="Star the ones you use most: they come first when adding an expense, on the Overview and in the plan. Stars are yours only."
                       Style="{StaticResource Caption}" Padding="4,0" />
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="16,40" Spacing="6">
                        <Label Text="No categories yet" Style="{StaticResource Title}" HorizontalOptions="Center" />
                        <Label Text="Tap + to add your first one." Style="{StaticResource Muted}" HorizontalOptions="Center" IsVisible="{Binding CanEdit}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="96" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:CategoryDto">
                        <SwipeView BackgroundColor="Transparent" Margin="0,4">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=CanEdit}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Row}" Margin="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=RenameCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Image Source="ic_tag.png" WidthRequest="20" HeightRequest="20" />
                                    <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Strong}" VerticalOptions="Center" />
                                    <!-- a 44pt target around the 22pt star -->
                                    <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" Margin="0,-10,-8,-10"
                                          SemanticProperties.Description="Star or unstar">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=ToggleStarCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="star_on.png" WidthRequest="22" HeightRequest="22" IsVisible="{Binding IsStarred}" />
                                        <Image Source="star_off.png" WidthRequest="22" HeightRequest="22" IsVisible="{Binding IsStarred, Converter={StaticResource InvertBool}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border Style="{StaticResource Fab}" IsVisible="{Binding CanEdit}" SemanticProperties.Description="Add category">
            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding AddCommand}" /></Border.GestureRecognizers>
            <Image Source="plus.png" WidthRequest="24" HeightRequest="24" />
        </Border>
    </Grid>
</views:BasePage>

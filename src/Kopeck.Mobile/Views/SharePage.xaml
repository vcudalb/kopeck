<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.SharePage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             xmlns:dto="clr-namespace:Kopeck.Contracts;assembly=Kopeck.Contracts"
             x:DataType="vm:ShareViewModel"
             Title="Share budget">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <!-- Invite -->
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">
                <Label Text="Invite someone" Style="{StaticResource Title}" />
                <Label Text="Use the email they sign in with (or will sign up with). Viewers can only look; editors can add expenses, income and plans."
                       Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Entry Placeholder="their@email.com" Keyboard="Email" Text="{Binding Email}" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Border Style="{StaticResource Field}">
                        <Picker Title="Access" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" />
                    </Border>
                    <Button Grid.Column="1" Text="Invite" Command="{Binding AddCommand}" IsEnabled="{Binding IsNotBusy}" WidthRequest="110" />
                </Grid>
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <Label Grid.Row="1" Text="PEOPLE WITH ACCESS" Style="{StaticResource SectionHeader}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Not shared with anyone yet." Style="{StaticResource Muted}" Padding="4,8" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:ShareDto">
                    <SwipeView BackgroundColor="Transparent" Margin="0,4">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Remove" BackgroundColor="{StaticResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShareViewModel}}, Path=RemoveCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource Row}" Margin="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Email}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Border Grid.Column="1" Style="{StaticResource Chip}">
                                    <Label Text="{Binding Role}" Style="{StaticResource ChipText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</views:BasePage>

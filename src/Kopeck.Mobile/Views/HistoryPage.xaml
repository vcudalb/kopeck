<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Class="Kopeck.Mobile.Views.HistoryPage"
             xmlns:views="clr-namespace:Kopeck.Mobile.Views"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kopeck.Mobile.ViewModels"
             x:DataType="vm:HistoryViewModel"
             Title="History">
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <!-- the expense as it is now -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Subject}" Style="{StaticResource Title}" />
                        <Label Text="{Binding SubjectDetail}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding Error}" Style="{StaticResource ErrorLabel}" />
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />

                <Label Text="WHAT HAPPENED" Style="{StaticResource SectionHeader}" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItem">
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Color="{Binding Accent}" />
                                    <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="4">
                                        <Label Text="{Binding Heading}" Style="{StaticResource Strong}" />
                                        <Label Text="{Binding ByText}" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding Lines}" IsVisible="{Binding HasLines}" Margin="0,6,0,0" LineHeight="1.2" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:BasePage>

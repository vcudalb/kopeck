<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- HTTP layer and composition root: routing, auth, rate limiting, mapping use-case results to status codes. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Needed by `dotnet ef` (this is the startup project; migrations live in Kopeck.Infrastructure). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kopeck.Application\Kopeck.Application.csproj" />
    <ProjectReference Include="..\Kopeck.Contracts\Kopeck.Contracts.csproj" />
    <ProjectReference Include="..\Kopeck.Infrastructure\Kopeck.Infrastructure.csproj" />
  </ItemGroup>

</Project>
